# App
PORT=3000
# Enforce "true" to expose Swagger UI (never enable in production)
SWAGGER_ENABLED=false
# Comma-separated list of allowed origins. Leave empty to disable browser CORS.
CORS_ORIGINS="http://localhost:3001,https://app.example.com"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mental_health?schema=public"

# JWT Access Token
JWT_ACCESS_SECRET="your-access-secret-change-me"
JWT_ACCESS_EXPIRATION="15m"

# JWT Refresh Token
JWT_REFRESH_SECRET="your-refresh-secret-change-me"
JWT_REFRESH_EXPIRATION="7d"

# Rate limiting (per IP). Defaults: 10 requests / 60000ms
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000