{
  "info": {
    "name": "Mental Health API",
    "description": "REST API for the Mental Health platform. Includes Journal, Check-ins, Profile, and Auth endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1",
    "_postman_id": "mental-health-api-collection"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "journalEntryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkInId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"Test User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has accessToken', function () { var json = pm.response.json(); pm.expect(json.accessToken).to.exist; });",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has accessToken', function () { var json = pm.response.json(); pm.expect(json.accessToken).to.exist; });",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has new accessToken', function () { var json = pm.response.json(); pm.expect(json.accessToken).to.exist; });",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Journal",
      "item": [
        {
          "name": "List Journal Entries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/journal?limit=20&includeArchived=false",
              "host": ["{{baseUrl}}"],
              "path": ["journal"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "includeArchived", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Create Journal Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/journal",
              "host": ["{{baseUrl}}"],
              "path": ["journal"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Morning Reflections\",\n  \"content\": \"Today I felt calm and focused. The meditation session helped clear my mind.\",\n  \"mood\": \"FOUR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has entry', function () { var json = pm.response.json(); pm.expect(json.id).to.exist; pm.collectionVariables.set('journalEntryId', json.id); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search Journal Entries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/journal/search?q=meditation",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "search"],
              "query": [
                { "key": "q", "value": "meditation" }
              ]
            }
          }
        },
        {
          "name": "Journal Calendar (Entry Counts)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/journal/calendar?from=2026-09-01&to=2026-09-30",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "calendar"],
              "query": [
                { "key": "from", "value": "2026-09-01" },
                { "key": "to", "value": "2026-09-30" }
              ]
            }
          }
        },
        {
          "name": "Get Single Journal Entry",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}"]
            }
          }
        },
        {
          "name": "Update Journal Entry (PUT - Replace)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Morning Reflections\",\n  \"content\": \"Updated content with more details about my day.\",\n  \"mood\": \"FIVE\",\n  \"tags\": [\"reflection\", \"meditation\", \"morning\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patch Journal Entry (PATCH - Partial)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"THREE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Archive Journal Entry",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}", "archive"]
            }
          }
        },
        {
          "name": "Restore Journal Entry",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}", "restore"]
            }
          }
        },
        {
          "name": "Delete Journal Entry",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/journal/{{journalEntryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["journal", "{{journalEntryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Mood Check-ins",
      "item": [
        {
          "name": "List Check-ins",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins?limit=30",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins"],
              "query": [
                { "key": "limit", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Create Check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-checkins",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"FOUR\",\n  \"intensity\": 4,\n  \"factors\": [\"sleep\", \"exercise\"],\n  \"emotions\": [\"Grateful\", \"Energetic\"],\n  \"influencers\": [\"Morning run\", \"Good sleep\"],\n  \"notes\": \"Felt great after morning workout and 8 hours of sleep.\",\n  \"date\": \"2026-09-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has check-in', function () { var json = pm.response.json(); pm.expect(json.id).to.exist; pm.collectionVariables.set('checkInId', json.id); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Today's Check-in",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/today",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "today"]
            }
          }
        },
        {
          "name": "Get Latest Check-in",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/latest",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "latest"]
            }
          }
        },
        {
          "name": "Check-in Calendar",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/calendar?from=2026-09-01&to=2026-09-30",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "calendar"],
              "query": [
                { "key": "from", "value": "2026-09-01" },
                { "key": "to", "value": "2026-09-30" }
              ]
            }
          }
        },
        {
          "name": "Get Single Check-in",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/{{checkInId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "{{checkInId}}"]
            }
          }
        },
        {
          "name": "Update Check-in (PUT - Replace)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/{{checkInId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "{{checkInId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood\": \"FIVE\",\n  \"intensity\": 5,\n  \"factors\": [\"sleep\", \"exercise\", \"nutrition\"],\n  \"emotions\": [\"Grateful\", \"Energetic\", \"Proud\"],\n  \"influencers\": [\"Morning run\", \"Good sleep\", \"Healthy breakfast\"],\n  \"notes\": \"Updated: Amazing day overall!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patch Check-in (PATCH - Partial)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/{{checkInId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "{{checkInId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intensity\": 3,\n  \"notes\": \"Updated notes only\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Check-in",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/mood-checkins/{{checkInId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mood-checkins", "{{checkInId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has profile with wellnessScore and dayStreak', function () { var json = pm.response.json(); pm.expect(json.profile).to.exist; pm.expect(json.profile.wellnessScore).to.exist; pm.expect(json.profile.dayStreak).to.exist; pm.expect(json.profile.preferences.dailyMoodReminder).to.exist; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Profile Settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile/settings",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "settings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated bio - mental health advocate\",\n  \"age\": 30,\n  \"gender\": \"female\",\n  \"reminderEnabled\": true,\n  \"reminderTime\": \"20:30\",\n  \"onboardingStep\": 3,\n  \"preferences\": {\n    \"dailyMoodReminder\": true,\n    \"journalReminder\": true,\n    \"streakAlerts\": true,\n    \"reminderTime\": \"20:30\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User (/users/me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "",
          "// Auto-set auth header from collection variable",
          "if (pm.collectionVariables.get('accessToken')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('accessToken') });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ]
}