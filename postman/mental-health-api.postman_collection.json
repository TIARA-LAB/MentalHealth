                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            },
            "description": "Soft-deletes the authenticated user's account and revokes all their refresh tokens. Requires a valid Bearer access token."
          },
          "response": []
        }
      ]
    }
  ]
}
